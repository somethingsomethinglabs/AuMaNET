{
  "name": "aumanet",
  "private": true,
  "type": "module",
  "workspaces": [
    "dev/app",
    "dev/mobile",
    "dev/packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check": "npm run typecheck && npm run docs:check && npm run cad:check",
    "typecheck": "tsc --build",
    "clean": "tsc --build --clean",
    "cad:check": "node scripts/check-cad.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check && node scripts/check-docs.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "firmware:release:test": "node --test dev/releases/release.test.mjs"
  },
  "devDependencies": {
    "marked": "18.1.3",
    "typescript": "~5.9.3"
  }
}
