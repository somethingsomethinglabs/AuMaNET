{
  "name": "aumanet",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "aumanet",
      "workspaces": [
        "dev/app",
        "dev/mobile",
        "dev/packages/*"
      ],
      "devDependencies": {
        "marked": "18.1.3",
        "typescript": "~5.9.3"
      },
      "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
      }
    },
    "dev/app": {
      "name": "@aumanet/app",
      "version": "0.0.0",
      "dependencies": {
        "@aumanet/core": "0.0.0"
      }
    },
    "dev/mobile": {
      "name": "@aumanet/mobile",
      "version": "0.0.0",
      "dependencies": {
        "@aumanet/core": "0.0.0"
      }
    },
    "dev/packages/core": {
      "name": "@aumanet/core",
      "version": "0.0.0",
      "dependencies": {
        "@aumanet/protocol": "0.0.0"
      }
    },
    "dev/packages/protocol": {
      "name": "@aumanet/protocol",
      "version": "0.0.0"
    },
    "dev/packages/simulator": {
      "name": "@aumanet/simulator",
      "version": "0.0.0",
      "dependencies": {
        "@aumanet/core": "0.0.0"
      }
    },
    "node_modules/@aumanet/app": {
      "resolved": "dev/app",
      "link": true
    },
    "node_modules/@aumanet/core": {
      "resolved": "dev/packages/core",
      "link": true
    },
    "node_modules/@aumanet/mobile": {
      "resolved": "dev/mobile",
      "link": true
    },
    "node_modules/@aumanet/protocol": {
      "resolved": "dev/packages/protocol",
      "link": true
    },
    "node_modules/@aumanet/simulator": {
      "resolved": "dev/packages/simulator",
      "link": true
    },
    "node_modules/marked": {
      "version": "18.1.3",
      "resolved": "https://registry.npmjs.org/marked/-/marked-18.1.3.tgz",
      "integrity": "sha512-9ChMH8EVVgjgID49nsL6IWxWk5c6GtAsq/xw7U1ggkjkU5AGuv68oLTVlFRtvcUYZtpbNyjyvGo3YDu0fGapiw==",
      "dev": true,
      "license": "MIT",
      "bin": {
        "marked": "bin/marked.js"
      },
      "engines": {
        "node": ">= 20"
      }
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    }
  }
}
