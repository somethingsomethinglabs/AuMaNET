CONFIG_AUMANET_GATEWAY=y
CONFIG_WIFI_MORSE_AU_CHANNELISATION_2024=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_IP4_FRAG=n
CONFIG_LWIP_IP4_REASSEMBLY=n
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_ECDH_C=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="gateway/partitions-ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="gateway/partitions-ota.csv"
